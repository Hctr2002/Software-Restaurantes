{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "NEXT_PUBLIC_SUPABASE_URL",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY",
    "NEXT_PUBLIC_AUTH_URL",
    "SUPABASE_SERVICE_ROLE_KEY",
    "NEXT_PUBLIC_MOCK_MODE",
    "NEXT_PUBLIC_KITCHEN_URL",
    "NEXT_PUBLIC_WAITER_URL",
    "NEXT_PUBLIC_LOCAL_DASHBOARD_URL",
    "NEXT_PUBLIC_CASHIER_URL",
    "NEXT_PUBLIC_CUSTOMER_PORTAL_URL",
    "NEXT_PUBLIC_BAR_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".next/**",
        "dist/**"
      ]
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ]
    },
    "test": {
      "dependsOn": [],
      "outputs": ["coverage/**"],
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}