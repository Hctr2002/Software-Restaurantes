generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["auth", "public"]
}

model Restaurant {
  id                   String               @id @default(uuid())
  name                 String
  slug                 String               @unique
  status               SubscriptionStatus   @default(ACTIVE)
  createdAt            DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime             @default(now()) @updatedAt @db.Timestamptz(3)
  planId               String?              @map("plan_id")
  stripeCustomerId     String?
  stripeSubscriptionId String?
  stripePriceId        String?
  currentPeriodEnd     DateTime?            @db.Timestamptz(6)
  alerts               alerts[]
  categories           Category[]
  inventories          Inventory[]
  kdsSettings          KdsSettings?
  menuItemExtras       MenuItemExtra[]
  menuItemIngredients  MenuItemIngredient[]
  menuItems            MenuItem[]
  orderItemExtras      OrderItemExtra[]
  orderItems           OrderItem[]
  orders               Order[]
  themes               Theme[]
  plan                 Plan?                @relation(fields: [planId], references: [id])
  tables               Table[]
  users                User[]

  @@map("restaurants")
  @@schema("public")
}

model User {
  id           String      @id
  email        String      @unique
  role         Role        @default(CLIENTE)
  restaurantId String?     @map("restaurant_id")
  pushToken    String?     @map("push_token")
  createdAt    DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime    @default(now()) @updatedAt @db.Timestamptz(3)
  alerts       alerts[]
  orders       Order[]
  restaurant   Restaurant? @relation(fields: [restaurantId], references: [id])

  @@index([restaurantId])
  @@index([restaurantId], map: "idx_users_restaurant_id")
  @@map("users")
  @@schema("public")
}

model Category {
  id           String     @id @default(dbgenerated("(gen_random_uuid())::text"))
  name         String
  restaurantId String     @map("restaurant_id")
  isActive     Boolean    @default(true) @map("is_active")
  createdAt    DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime   @default(now()) @updatedAt @db.Timestamptz(3)
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  menuItems    MenuItem[]

  @@unique([id, restaurantId])
  @@index([restaurantId])
  @@map("categories")
  @@schema("public")
}

model MenuItem {
  id           String               @id @default(dbgenerated("(gen_random_uuid())::text"))
  name         String
  description  String?
  price        Decimal              @db.Decimal(10, 2)
  imageUrl     String?              @map("image_url")
  categoryId   String               @map("category_id")
  restaurantId String               @map("restaurant_id")
  isActive     Boolean              @default(true) @map("is_active")
  createdAt    DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime             @default(now()) @updatedAt @db.Timestamptz(3)
  extras       MenuItemExtra[]
  ingredients  MenuItemIngredient[]
  category     Category             @relation(fields: [categoryId, restaurantId], references: [id, restaurantId])
  restaurant   Restaurant           @relation(fields: [restaurantId], references: [id])
  orderItems   OrderItem[]

  @@unique([id, restaurantId])
  @@index([restaurantId])
  @@index([categoryId, restaurantId])
  @@map("menu_items")
  @@schema("public")
}

model MenuItemIngredient {
  id           String     @id @default(uuid())
  menuItemId   String     @map("menu_item_id")
  inventoryId  String     @map("inventory_id")
  quantity     Decimal    @db.Decimal(10, 2)
  restaurantId String     @map("restaurant_id")
  inventory    Inventory  @relation(fields: [inventoryId], references: [id])
  menuItem     MenuItem   @relation(fields: [menuItemId], references: [id])
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])

  @@unique([menuItemId, inventoryId])
  @@index([restaurantId])
  @@index([inventoryId], map: "idx_menu_item_ingredients_inventory")
  @@index([menuItemId], map: "idx_menu_item_ingredients_menu_item")
  @@map("menu_item_ingredients")
  @@schema("public")
}

model MenuItemExtra {
  id              String           @id @default(uuid())
  name            String
  price           Decimal          @db.Decimal(10, 2)
  menuItemId      String           @map("menu_item_id")
  inventoryId     String?          @map("inventory_id")
  quantity        Decimal          @default(1) @db.Decimal(10, 2)
  restaurantId    String           @map("restaurant_id")
  inventory       Inventory?       @relation(fields: [inventoryId], references: [id])
  menuItem        MenuItem         @relation(fields: [menuItemId], references: [id])
  restaurant      Restaurant       @relation(fields: [restaurantId], references: [id])
  orderItemExtras OrderItemExtra[]

  @@index([restaurantId])
  @@index([menuItemId], map: "idx_menu_item_extras_menu_item")
  @@map("menu_item_extras")
  @@schema("public")
}

model Table {
  id                 String      @id @default(dbgenerated("(gen_random_uuid())::text"))
  number             Int
  label              String?
  status             TableStatus @default(FREE)
  qrData             String      @unique @map("qr_data")
  restaurantId       String      @map("restaurant_id")
  helpRequested      Boolean     @default(false) @map("help_requested")
  billRequested      Boolean     @default(false) @map("bill_requested")
  createdAt          DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime    @default(now()) @updatedAt @db.Timestamptz(3)
  current_session_id String?     @db.Uuid
  tip_included       Boolean?    @default(false)
  orders             Order[]
  restaurant         Restaurant  @relation(fields: [restaurantId], references: [id])

  @@unique([id, restaurantId])
  @@unique([restaurantId, number])
  @@index([restaurantId])
  @@index([current_session_id], map: "idx_tables_current_session_id")
  @@index([current_session_id])
  @@map("tables")
  @@schema("public")
}

model Order {
  id           String      @id @default(uuid())
  tableId      String?     @map("table_id")
  restaurantId String      @map("restaurant_id")
  status       OrderStatus @default(PENDING)
  totalAmount  Decimal     @default(0) @map("total_amount") @db.Decimal(10, 2)
  notes        String?
  createdAt    DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime    @default(now()) @updatedAt @db.Timestamptz(3)
  user_id      String?
  validatedAt  DateTime?   @map("validated_at") @db.Timestamptz(6)
  preparingAt  DateTime?   @map("preparing_at") @db.Timestamptz(6)
  readyAt      DateTime?   @map("ready_at") @db.Timestamptz(6)
  sessionId    String?     @map("session_id") @db.Uuid
  orderItems   OrderItem[]
  restaurant   Restaurant  @relation(fields: [restaurantId], references: [id])
  tables       Table?      @relation(fields: [tableId], references: [id], onUpdate: NoAction)
  users        User?       @relation(fields: [user_id], references: [id], onUpdate: NoAction)

  @@unique([id, restaurantId])
  @@index([restaurantId])
  @@index([restaurantId], map: "idx_orders_restaurant_id")
  @@index([sessionId], map: "idx_orders_session_id")
  @@index([user_id], map: "idx_orders_user_id")
  @@map("orders")
  @@schema("public")
}

model OrderItem {
  id           String           @id @default(uuid())
  orderId      String           @map("order_id")
  menuItemId   String           @map("menu_item_id")
  restaurantId String           @map("restaurant_id")
  quantity     Int
  unitPrice    Decimal          @map("unit_price") @db.Decimal(10, 2)
  notes        String?
  extras       OrderItemExtra[]
  menuItem     MenuItem         @relation(fields: [menuItemId], references: [id])
  order        Order            @relation(fields: [orderId, restaurantId], references: [id, restaurantId])
  restaurant   Restaurant       @relation(fields: [restaurantId], references: [id])

  @@index([restaurantId])
  @@index([orderId, restaurantId])
  @@index([menuItemId], map: "idx_order_items_menu_item")
  @@map("order_items")
  @@schema("public")
}

model OrderItemExtra {
  id           String        @id @default(uuid())
  orderItemId  String        @map("order_item_id")
  extraId      String        @map("extra_id")
  restaurantId String        @map("restaurant_id")
  price        Decimal       @db.Decimal(10, 2)
  extra        MenuItemExtra @relation(fields: [extraId], references: [id])
  orderItem    OrderItem     @relation(fields: [orderItemId], references: [id])
  restaurant   Restaurant    @relation(fields: [restaurantId], references: [id])

  @@index([restaurantId])
  @@index([extraId], map: "idx_order_item_extras_extra")
  @@index([orderItemId], map: "idx_order_item_extras_item")
  @@map("order_item_extras")
  @@schema("public")
}

model Inventory {
  id                  String               @id @default(dbgenerated("(gen_random_uuid())::text"))
  name                String
  stock               Decimal              @db.Decimal(10, 2)
  unit                String
  restaurantId        String               @map("restaurant_id")
  createdAt           DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime             @default(now()) @updatedAt @db.Timestamptz(3)
  restaurant          Restaurant           @relation(fields: [restaurantId], references: [id])
  extraRelations      MenuItemExtra[]
  ingredientRelations MenuItemIngredient[]

  @@index([restaurantId])
  @@map("inventories")
  @@schema("public")
}

model Plan {
  id          String       @id @default(uuid())
  name        String
  price       String
  period      String       @default("/mes")
  description String?
  features    String[]
  popular     Boolean      @default(false)
  createdAt   DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime     @default(now()) @updatedAt @db.Timestamptz(3)
  restaurants Restaurant[]

  @@map("plans")
  @@schema("public")
}

model Theme {
  id              String     @id @default(dbgenerated("(gen_random_uuid())::text"))
  restaurantId    String     @map("restaurant_id")
  paletteName     String?    @map("palette_name")
  primaryColor    String     @map("primary_color")
  secondaryColor  String     @map("secondary_color")
  backgroundColor String     @map("background_color")
  accentColor     String     @map("accent_color")
  textColor       String     @map("text_color")
  cardBackground  String     @map("card_background")
  created_at      DateTime?  @default(now()) @db.Timestamptz(6)
  updated_at      DateTime?  @default(now()) @db.Timestamptz(6)
  name            String     @default("Tema sin nombre")
  isCustom        Boolean?   @default(false) @map("is_custom")
  isActive        Boolean?   @default(false) @map("is_active")
  fontTitle       String     @default("Outfit") @map("font_title")
  fontBody        String     @default("Inter") @map("font_body")
  logoUrl         String?    @map("logo_url")
  font_accent     String?    @default("Outfit")
  restaurant      Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("restaurant_themes")
  @@schema("public")
}

model KdsSettings {
  id           String     @id @default(uuid())
  restaurantId String     @unique @map("restaurant_id")
  settings     Json
  createdAt    DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime   @default(now()) @updatedAt @db.Timestamptz(3)
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@map("kds_settings")
  @@schema("public")
}

