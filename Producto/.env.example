# Node.js HTTP header size — prevents HTTP 431 from large Supabase auth cookies
NODE_OPTIONS="--max-http-header-size=65536"
# Supabase Client Credentials (Frontend)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

EXPO_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
EXPO_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
# Agrega esto a tu archivo .env
SUPABASE_SERVICE_ROLE_KEY=tu_secret_key_completa_aqui

# Centralized Auth Configuration
# Domain where admin-dashboard (login gateway) is running
NEXT_PUBLIC_AUTH_URL="http://localhost:3000"

# Demo / Testing Mode — set to "true" to run kitchen-kds with mock data (no Supabase needed)
NEXT_PUBLIC_MOCK_MODE="false"

# VAPID Keys — Web Push (Waiter Terminal)
# Generar con: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY="BNxxx...tu-clave-publica..."
VAPID_PRIVATE_KEY="xxx...tu-clave-privada..."
VAPID_EMAIL="mailto:tu@email.com"

# Database Connection (Backend/Migrations)
# Use values from supabase/.env
DATABASE_URL="postgresql://postgres.xxxx:password@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxxx:password@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

# URLs de apps por rol (desarrollo local) — usadas por admin-dashboard/src/proxy.ts
NEXT_PUBLIC_KITCHEN_URL="http://localhost:3001"
NEXT_PUBLIC_WAITER_URL="http://localhost:3002"
NEXT_PUBLIC_LOCAL_DASHBOARD_URL="http://localhost:3003"
NEXT_PUBLIC_CASHIER_URL="http://localhost:3004"
NEXT_PUBLIC_CUSTOMER_PORTAL_URL="http://localhost:3005"
NEXT_PUBLIC_BAR_URL="http://localhost:3006"