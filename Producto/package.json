{
  "name": "menu-bites-monorepo",
  "private": true,
  "scripts": {
    "dev": "dotenv -e .env -- turbo dev --filter=!menu-bites",
    "dev:all": "dotenv -e .env -- turbo dev",
    "dev:mobile": "dotenv -e .env -- turbo dev --filter=menu-bites",
    "build": "dotenv -e .env -- turbo build",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "lerna:version": "lerna version",
    "lerna:publish": "lerna publish from-package"
  },
  "devDependencies": {
    "dotenv-cli": "^8.0.0",
    "lerna": "^9.0.7",
    "prettier": "^3.2.5",
    "turbo": "latest"
  },
  "packageManager": "npm@10.2.4",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "@prisma/client": "^5.15.0",
    "@supabase/supabase-js": "^2.103.0",
    "@types/pg": "^8.20.0",
    "cross-spawn": "^7.0.6",
    "dotenv": "^17.4.1",
    "pg": "^8.20.0",
    "prisma": "^5.15.0",
    "tsx": "^4.21.0"
  },
  "overrides": {
    "axios": "1.16.0",
    "postcss": "8.5.10",
    "react-native-worklets": "0.5.1",
    "react-native-reanimated": "4.1.1"
  }
}
