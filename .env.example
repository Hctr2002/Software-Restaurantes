# Supabase Client Credentials (Frontend)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
# Agrega esto a tu archivo .env
SUPABASE_SERVICE_ROLE_KEY=tu_secret_key_completa_aqui

# Centralized Auth Configuration
# Domain where admin-dashboard (login gateway) is running
NEXT_PUBLIC_AUTH_URL="http://localhost:3000"

# Database Connection (Backend/Migrations)
# Use values from supabase/.env
DATABASE_URL="postgresql://postgres.xxxx:password@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxxx:password@aws-0-us-east-1.pooler.supabase.com:5432/postgres"
