{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "skipLibCheck": true,
    "lib": ["esnext"],
    "types": ["react-native"],
    "paths": {
      "@/*": [
        "./*"
      ],
      "lucide-react-native": ["../../node_modules/lucide-react-native"],
      "react": ["../../node_modules/react"],
      "react-native": ["../../node_modules/react-native"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
